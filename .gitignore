# Collected static files (generated at deploy time)
/staticfiles/
/static/

# Specs now live in docs/specs/ (moved out of the tool-specific folder).
# The broad "docs/*" and "*.md" rules earlier in this file would otherwise
# drop them from every "git add -A": the already-tracked copies would
# freeze and any new spec would be skipped without a word.
!docs/specs/
!docs/specs/**

# Bundled Agmarknet filter reference (states, commodities, grades). The
# broad "data/" rule earlier is meant for downloaded datasets, but it
# also swallowed this source file: the service reads it at import time,
# so it shipped without the bundle and CI failed on a file that was
# sitting right there in the working tree.
!backend/advisory/data/
!backend/advisory/data/*.json

# Extra local DB files in backend (only backend/db.sqlite3 allowed by Django rule above)
backend/live_test.db
backend/local.db
backend/quick_check.sqlite3
backend/verify_features.sqlite3

# Phase1 ChromaDB vector store (generated locally)
phase1/chroma_db/

# Playwright output (CI uploads reports/traces as artifacts)
frontend/test-results/
frontend/playwright-report/

# ── Crop-disease production serving artifacts ───────────────────
# The rules above ignore models/ and *.tflite, which is right for the large
# training checkpoints. But Render builds the web service FROM SOURCE, so the
# small serving artifacts must be committed or production can never load the
# model. Re-include just those (a parent dir must be un-excluded first, hence
# the stepwise negations). The ~50 MB .keras stays ignored - only the 21.6 MB
# float16 .tflite is used in production.
!models/
models/*
!models/crop_disease/
models/crop_disease/*
!models/crop_disease/*.tflite
!models/crop_disease/class_labels.json
!models/crop_disease/metrics.json
!models/crop_disease/training_history.json
