{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agri-advisory-web.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://agri-advisory-web.onrender.com/media/:path*" }
  ]
}
