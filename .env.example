# ═══════════════════════════════════════════════════════════════
# KrishiMitra AI — Environment Configuration
# Copy to .env at project root and fill in your values.
# NEVER commit .env to version control.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ═══════════════════════════════════════════════════════════════

# ── Django Core (REQUIRED in production) ────────────────────────
SECRET_KEY=
DEBUG=False
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_TRUSTED_PROXIES=1
RATE_LIMIT_PUBLIC_RPM=100
RATE_LIMIT_PUBLIC_RPH=2000
RATE_LIMIT_PUBLIC_RPD=20000
RATE_LIMIT_AUTHENTICATED_RPM=240
RATE_LIMIT_AUTHENTICATED_RPH=5000
RATE_LIMIT_AUTHENTICATED_RPD=50000
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_AUTH_RPH=100
RATE_LIMIT_AUTH_RPD=500
RATE_LIMIT_HEAVY_RPM=20
RATE_LIMIT_HEAVY_RPH=300
RATE_LIMIT_HEAVY_RPD=3000
RATE_LIMIT_CHAT_CAPACITY=60
RATE_LIMIT_CHAT_FILL_RATE=1.0
RATE_LIMIT_DATA_CAPACITY=120
RATE_LIMIT_DATA_FILL_RATE=2.0
RATE_LIMIT_DIAG_CAPACITY=20
RATE_LIMIT_DIAG_FILL_RATE=0.33
RATE_LIMIT_DEFAULT_CAPACITY=200
RATE_LIMIT_DEFAULT_FILL_RATE=3.0
RATE_LIMIT_NOMINATIM_CAPACITY=10
RATE_LIMIT_NOMINATIM_FILL_RATE=1.0
AUTH_BACKOFF_THRESHOLD=3
AUTH_BACKOFF_BASE_SECONDS=2
AUTH_BACKOFF_MAX_SECONDS=300
AUTH_BACKOFF_WINDOW_SECONDS=3600
OTP_REQUEST_CAPACITY=3
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_VERIFY_CAPACITY=3
OTP_VERIFY_WINDOW_SECONDS=3600
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SETTINGS_MODULE=core.settings

# HTTPS behind reverse proxy (Render / Railway / Nginx)
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── Database ─────────────────────────────────────────────────────
# SQLite — local dev only
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL — recommended for production
# DATABASE_URL=postgresql://user:password@host:5432/krishimitra

# ── data.gov.in — REQUIRED for live mandi prices ────────────────
# Free registration: https://data.gov.in/user/register → API Keys
# Without a valid key, state/mandi coverage may be unavailable. The app never
# substitutes synthetic or MSP-estimate rows for live prices.
DATA_GOV_IN_API_KEY=
# Mandi rows older than this are rejected instead of shown as current prices.
MANDI_MAX_DATA_AGE_HOURS=72

# ── Google Gemini AI — optional (chat grounding) ────────────────
# https://aistudio.google.com/app/apikey (free tier available)
# Without this key the chatbot uses the built-in rule-based fallback
# which covers 22 languages and 60+ farming topics.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash

# ── OpenWeatherMap — optional (Open-Meteo is free, no key needed) 
# https://openweathermap.org/api (free tier: 1000 calls/day)
# Open-Meteo is used by default — set this only for additional coverage.
OPENWEATHER_API_KEY=

# ── Redis / Celery — optional background tasks ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── Sentry Error Monitoring — optional ──────────────────────────
SENTRY_DSN=

# ── Frontend ─────────────────────────────────────────────────────
# Set SERVE_FRONTEND=true to have Django serve frontend/dist/ directly
# (useful for single-container deployments on Render/Railway)
SERVE_FRONTEND=false
FRONTEND_AT_ROOT=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-cdn.example

# ── Upload Limits ────────────────────────────────────────────────
# Maximum image upload size for KrishiRaksha (crop disease detection)
KRISHI_RAKSHA_MAX_UPLOAD_MB=5
# Django parser limits and private future-upload location. Diagnostic images
# are validated in memory and are not persisted by the current API.
DATA_UPLOAD_MAX_MEMORY_SIZE=8388608
FILE_UPLOAD_MAX_MEMORY_SIZE=8388608
PRIVATE_UPLOAD_ROOT=/var/lib/krishimitra/private_uploads

# ── Feature Flags ────────────────────────────────────────────────
ML_ALLOW_UNVERIFIED_MODEL=false
LAUNCH_CHECK=false

# ── Local Dev Only ───────────────────────────────────────────────
# DEBUG=True
# RATE_LIMIT_ENABLED=false
# DATABASE_URL=sqlite:///db.sqlite3
# SECURE_SSL_REDIRECT=False

# ── WhatsApp Business API (Meta Cloud API) ────────────────────────
# HOW TO GET (free, 5 min setup):
#   1. Go to https://developers.facebook.com → Create App → WhatsApp Business
#   2. Add WhatsApp Business product to your app
#   3. Set Webhook URL: https://your-domain.com/api/sms-ivr/whatsapp/
#   4. Set Webhook Verify Token = same as WHATSAPP_VERIFY_TOKEN below
#   5. Copy the "Temporary Access Token" → WHATSAPP_TOKEN
#   6. Copy the "Phone Number ID"        → WHATSAPP_PHONE_ID
# FREE LIMITS: 1,000 conversations/month — no credit card for sandbox
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Twilio SMS/IVR (Alternative channel) ─────────────────────────
# HOW TO GET: https://www.twilio.com/try-twilio (free $15 trial credit)
# Webhook URL: https://your-domain.com/api/sms-ivr/sms/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Groq Whisper STT — Voice messages for WhatsApp ───────────────
# Farmers send voice notes in Hindi/Bhojpuri/Tamil etc. — Groq transcribes.
# FREE: 7,200 audio seconds/day — no credit card needed
# HOW TO GET: https://console.groq.com → Sign up (GitHub login) → API Keys → Create Key
# Supported: Hindi, Marathi, Gujarati, Tamil, Telugu, Kannada, Bengali, Punjabi, English
GROQ_API_KEY=

# ── Performance / Thread Tuning ──────────────────────────────────
# Adjust thread pool workers for async API calls (e.g. weather + mandi fetches).
# Render instances / memory-constrained envs: 20-50 is optimal.
FETCH_POOL_WORKERS=8

# ── MQTT / IoT (ESP32 Sensor Integration) ────────────────────────
# Required only if you connect ESP32 soil sensors to the backend.
# For dev: leave as localhost (no broker needed unless ESP32 is connected).
# For prod: use a managed MQTT broker (HiveMQ Cloud free tier, or self-hosted Mosquitto).
# HOW TO SET UP: pip install paho-mqtt==1.6.1
#                Then run: python manage.py run_mqtt_subscriber
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=krishimitra/farm
MQTT_CLIENT_ID=krishimitra-backend

# ──────────────────────────────────────────────────────────────────
# SERVICES AND WHAT THEY NEED:
#
# ✅ Weather (Open-Meteo)        — No key needed, always real-time
# ✅ Soil layers (Open-Meteo)    — No key needed, field-level precision
# ✅ Crop recommendations         — No key needed, 200+ Indian crop profiles
# ✅ Field advisory (IoT)         — No key needed, ICAR + Open-Meteo
# ✅ Government schemes           — No key needed, curated catalog
# ✅ Disease detection (ML)       — No key needed (model file optional)
# ✅ Session memory + admin panel — No key needed
# ✅ Mandi prices (state live)    — No key via Agmarknet 2.0 dashboard
# ⚠️  Exact-mandi/full coverage   — Needs DATA_GOV_IN_API_KEY
# ✅ Chatbot (local AI + RAG)      — Ollama/Phase 1 preferred; Gemini optional
# ⚠️  WhatsApp replies            — Needs WHATSAPP_TOKEN + WHATSAPP_PHONE_ID
# ⚠️  Voice STT (WhatsApp audio)  — Needs GROQ_API_KEY (free 7200 sec/day)
# ⚠️  Twilio SMS replies          — Needs TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN
# ⚠️  ESP32 IoT sensors           — Needs MQTT_BROKER_HOST (local or cloud)
# ──────────────────────────────────────────────────────────────────

# ── Local LLM + KrishiMitra RAG ──────────────────────────────────────────────
# qwen2.5:7b is the production default because it currently passes the grounded
# answer-quality checks. Use krishimitra-llm only after its eval report passes.
# Then start phase1: cd phase1 && bash start.sh
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Docker exposes Phase 1 on host port 8002. If running phase1/start.sh directly,
# use the port printed by that service instead.
PHASE1_BASE_URL=http://127.0.0.1:8002
PHASE1_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PHASE1_ALLOW_ALL_CORS=false
PHASE1_TIMEOUT_S=8
PHASE1_STREAM_FIRST_TOKEN_TIMEOUT_S=12
PHASE1_STREAM_IDLE_TIMEOUT_S=15
PHASE1_STREAM_TOTAL_TIMEOUT_S=40
OLLAMA_DIRECT_TIMEOUT_S=8
OLLAMA_CHAT_TIMEOUT_S=45
# Fail Phase 1 startup when the current knowledge files cannot be indexed.
# Keep false for local development; set true for a production local-AI service.
RAG_INDEX_REQUIRED=false
CHAT_LOCAL_AI_MAX_CONCURRENCY=1
CHAT_REALTIME_TIMEOUT_S=4
