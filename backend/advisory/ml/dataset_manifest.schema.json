{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishimitra.local/schemas/disease-dataset-manifest-1.0.json",
  "title": "KrishiMitra crop disease dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_name", "created_at", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "source_url", "license_name", "license_url", "retrieved_at",
          "crop_labels", "disease_labels", "sample_count", "splits", "usage_approved"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "license_name": {"type": "string", "minLength": 1},
          "license_url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date"},
          "crop_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "disease_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sample_count": {"type": "integer", "minimum": 1},
          "splits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["train", "validation", "test"],
            "properties": {
              "train": {"type": "integer", "minimum": 0},
              "validation": {"type": "integer", "minimum": 0},
              "test": {"type": "integer", "minimum": 0}
            }
          },
          "usage_approved": {"type": "boolean"}
        }
      }
    }
  }
}
